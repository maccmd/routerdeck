{
  "name": "routerdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-console.mjs && node scripts/preview.mjs",
    "dev:console": "node scripts/build-console.mjs && node scripts/preview.mjs --watch-console",
    "build": "node scripts/build-console.mjs",
    "build:console": "node scripts/build-console.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:vm": "playwright test --config playwright.vm.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/signals": "2.11.2",
    "esbuild": "0.28.2",
    "preact": "10.29.8"
  }
}
