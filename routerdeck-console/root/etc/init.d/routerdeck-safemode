#!/bin/sh /etc/rc.common
# RouterDeck Console Safe Mode watchdog. Started on demand by the routerdeck
# rpcd plugin, never at boot: Safe Mode state lives in /var/run.

USE_PROCD=1

start_service() {
	[ -f /var/run/routerdeck/safemode/state.json ] || return 0
	procd_open_instance watchdog
	procd_set_param command /usr/bin/ucode /usr/libexec/routerdeck/safemode-watchdog
	procd_set_param stderr 1
	procd_close_instance
}
