#!/bin/sh /etc/rc.common
# RouterDeck Graphing: keeps averages of interface traffic, CPU load and
# memory use for a day, a week, a month and a year, as RouterOS's graphing
# does. Runs only when enabled in /etc/config/routerdeck.

START=99
USE_PROCD=1

start_service() {
	local enabled
	config_load routerdeck
	config_get_bool enabled graphing enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance graphing
	procd_set_param command /usr/bin/ucode /usr/libexec/routerdeck/graphing
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger routerdeck
}
