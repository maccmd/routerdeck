{
	"routerdeck-console": {
		"description": "RouterDeck Console",
		"read": {
			"cgi-io": [ "backup" ],
			"ubus": {
				"iwinfo": [ "assoclist", "devices", "info" ],
				"luci": [ "getRealtimeStats", "getTimezones", "getUnixtime" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints", "getNetworkDevices", "getWirelessDevices" ],
				"network": [ "get_proto_handlers" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"rc": [ "list" ],
				"routerdeck": [ "certificates", "conntrack", "crontab", "ddns", "diag", "disks", "files", "fw_counters", "history", "info", "leds", "log", "neighbors", "netwatch", "packages", "qdisc", "routes", "rules", "terminal", "trusted", "upnp", "wireguard" ],
				"session": [ "destroy" ],
				"system": [ "board", "info" ],
				"uci": [ "get" ]
			},
			"uci": [ "ddns", "dhcp", "dropbear", "firewall", "fstab", "network", "routerdeck", "sqm", "system", "ttyd", "uhttpd", "upnpd", "wireless" ]
		},
		"write": {
			"ubus": {
				"luci": [ "setLocaltime", "setPassword" ],
				"rc": [ "init" ],
				"routerdeck": [ "apply", "certificate", "file_mkdir", "file_remove", "firmware", "mount", "redo", "reset", "restore", "safemode", "task", "undo", "unmount", "users", "wol" ],
				"system": [ "reboot" ]
			},
			"file": {
				"/*": [ "read", "write" ]
			}
		}
	}
}
