{
	"routerdeck-console": {
		"description": "RouterDeck Console",
		"read": {
			"cgi-io": [ "backup" ],
			"ubus": {
				"iwinfo": [ "assoclist", "devices", "info" ],
				"luci": [ "getTimezones", "getUnixtime" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints", "getNetworkDevices", "getWirelessDevices" ],
				"network": [ "get_proto_handlers" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"rc": [ "list" ],
				"routerdeck": [ "conntrack", "crontab", "diag", "fw_counters", "history", "info", "log", "neighbors", "packages", "routes", "rules", "terminal", "wireguard" ],
				"session": [ "destroy" ],
				"system": [ "board", "info" ],
				"uci": [ "get" ]
			},
			"uci": [ "dhcp", "dropbear", "firewall", "network", "system", "ttyd", "uhttpd", "wireless" ]
		},
		"write": {
			"ubus": {
				"luci": [ "setLocaltime", "setPassword" ],
				"rc": [ "init" ],
				"routerdeck": [ "apply", "redo", "safemode", "undo" ],
				"system": [ "reboot" ]
			}
		}
	}
}
