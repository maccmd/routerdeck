{
	"routerdeck-console": {
		"description": "RouterDeck Console",
		"read": {
			"ubus": {
				"iwinfo": [ "assoclist", "devices", "info" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints", "getNetworkDevices" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"network.wireless": [ "status" ],
				"routerdeck": [ "conntrack", "fw_counters", "history", "info", "log", "ping", "routes", "terminal", "traceroute" ],
				"session": [ "destroy" ],
				"system": [ "board", "info" ],
				"uci": [ "get" ]
			},
			"uci": [ "dhcp", "firewall", "network", "system", "ttyd", "wireless" ]
		},
		"write": {
			"ubus": {
				"routerdeck": [ "apply", "redo", "safemode", "undo" ]
			}
		}
	}
}
