// SPDX-License-Identifier: Apache-2.0
// RouterDeck Console backend for rpcd, exposed as the ubus object
// `routerdeck`. Access is granted by acl.d/routerdeck-console.json.
//
// Every change is one `apply` call: operations are staged in a private UCI
// delta directory, committed, validated and announced, and recorded with the
// previous file contents so they can be undone. Safe Mode keeps a snapshot
// that a separate watchdog restores when the client stops sending heartbeats.
//
// Functions are defined before their callers: ucode does not hoist them.
'use strict';

import { access, readfile, writefile, unlink, open, lsdir, stat, lstat, readlink, mkdir, rmdir } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';
import {
	CONFIGS, FILES, RUN, SAFE, LAST_ROLLBACK, DELTA, DIAG, HISTORY_ID, SAFE_LIMIT, SAFE_TIMEOUT,
	ensure_dirs, read_json, write_json, write_text, config_text, write_config, announce,
	luci_rollback_pending, history_load, history_save, safe_state,
	safe_heartbeat, safe_clear, safe_restore, log_message, sync_firewall_sets, sync_mounts, sync_leds, sync_sysctl, sysctl_path, restart_wireguard, merge_config
} from 'routerdeck.core';

const VERSION = '0.1.0';
const API = 1;
// UCI section and option names allow [A-Za-z0-9_]; section types also allow '-' (bridge-vlan).
const NAME = /^[A-Za-z0-9_]+$/;
const TYPE = /^[A-Za-z0-9_-]+$/;
const FACILITIES = [ 'kern', 'user', 'mail', 'daemon', 'auth', 'syslog', 'lpr', 'news', 'uucp', 'cron', 'authpriv', 'ftp' ];
const SEVERITIES = [ 'emerg', 'alert', 'crit', 'err', 'warning', 'notice', 'info', 'debug' ];
const ROUTE_TYPES = [ 'local', 'broadcast', 'multicast', 'throw', 'unreachable', 'prohibit', 'blackhole', 'nat', 'anycast' ];
const BUSY = 'LuCI is waiting to confirm applied changes. Try again after it confirms or rolls back.';

function failure(code, message, extra) {
	return { ok: false, error: code, message, ...(extra ?? {}) };
}

function executable(path) {
	return access(path, 'x') == true;
}

// Inside rpcd, reading a popen() pipe returns only what has arrived so far,
// so commands write to a file and are waited for with system().
let run_serial = 0;
function run(command) {
	ensure_dirs();
	let path = sprintf('%s/run.%d.%d', RUN, time(), ++run_serial);
	let code = system([ '/bin/sh', '-c', command + ' >' + path + ' 2>&1' ]);
	let output = readfile(path) ?? '';
	unlink(path);
	return { code, output };
}

// The ttyd package installs /usr/bin/ttyd; accept /usr/sbin for custom builds.
function ttyd_installed() {
	return executable('/usr/bin/ttyd') || executable('/usr/sbin/ttyd');
}

function user_of(request) {
	return request.info?.acl?.user ?? 'root';
}

/* --- Kernel routes ------------------------------------------------------ */

// Busybox `ip` has no JSON output; parse its text form as a fallback.
function parse_route_line(line) {
	let words = filter(split(trim(line), /\s+/), length);
	if (!length(words))
		return null;
	let route = { flags: [] };
	if (words[0] in ROUTE_TYPES)
		route.type = shift(words);
	route.dst = shift(words);
	let names = { via: 'gateway', dev: 'dev', table: 'table', proto: 'protocol', scope: 'scope', src: 'prefsrc', metric: 'metric' };
	while (length(words)) {
		let word = shift(words);
		if (names[word] && length(words))
			route[names[word]] = word == 'metric' ? int(shift(words)) : shift(words);
		else
			push(route.flags, word);
	}
	return route;
}

function routes(family) {
	let flag = family == 6 ? '-6' : '-4';
	let result = run(`ip -j ${flag} route show table all 2>/dev/null`);
	let parsed = null;
	if (result.code == 0) {
		try { parsed = json(result.output); } catch (e) { parsed = null; }
	}
	if (type(parsed) != 'array') {
		result = run(`ip ${flag} route show table all 2>/dev/null`);
		parsed = filter(map(split(result.output, '\n'), parse_route_line), route => route != null);
	}
	return parsed;
}

/* --- Firewall counters -------------------------------------------------- */

// fw4 tags rules with `comment "!fw4: <name>"`; one UCI section can produce
// several nftables rules, whose counters are summed.
function fw_counters() {
	if (!executable('/usr/sbin/nft'))
		return { available: false, counters: {} };
	let result = run('nft --terse --json list table inet fw4 2>/dev/null');
	let parsed = null;
	try { parsed = json(result.output); } catch (e) { parsed = null; }
	let counters = {};
	for (let item in parsed?.nftables ?? []) {
		let rule = item.rule;
		if (!rule || type(rule.comment) != 'string' || substr(rule.comment, 0, 6) != '!fw4: ')
			continue;
		let counter = null;
		for (let expr in rule.expr ?? [])
			if (expr.counter)
				counter = expr.counter;
		if (!counter)
			continue;
		let name = substr(rule.comment, 6);
		let total = counters[name] ?? [ 0, 0 ];
		counters[name] = [ total[0] + counter.packets, total[1] + counter.bytes ];
	}
	return { available: result.code == 0, counters };
}

/* --- Connection tracking ------------------------------------------------ */

function parse_conntrack(line) {
	let words = split(trim(line), /\s+/);
	if (length(words) < 6)
		return null;
	let entry = { family: words[0], protocol: words[2], timeout: int(words[4]), packets: 0, bytes: 0, tx_packets: 0, tx_bytes: 0, rx_packets: 0, rx_bytes: 0, flags: [] };
	let reply = false;
	for (let i = 5; i < length(words); i++) {
		let word = words[i];
		let pair = match(word, /^([a-z]+)=(.*)$/);
		if (!pair) {
			if (substr(word, 0, 1) == '[')
				push(entry.flags, substr(word, 1, length(word) - 2));
			else if (i == 5)
				entry.state = word;
			continue;
		}
		let key = pair[1], value = pair[2];
		if (key == 'src' && entry.src != null)
			reply = true;
		if (!reply && key in [ 'src', 'dst', 'sport', 'dport', 'type', 'code', 'id' ])
			entry[key] = value;
		else if (reply && key in [ 'src', 'dst' ] && entry['reply_' + key] == null)
			entry['reply_' + key] = value;
		else if (key == 'packets') {
			entry.packets += int(value);
			entry[reply ? 'rx_packets' : 'tx_packets'] += int(value);
		}
		else if (key == 'bytes') {
			entry.bytes += int(value);
			entry[reply ? 'rx_bytes' : 'tx_bytes'] += int(value);
		}
	}
	return entry;
}

function conntrack(limit) {
	let file = open('/proc/net/nf_conntrack', 'r');
	let entries = [];
	if (file) {
		let line;
		while (length(entries) < limit && (line = file.read('line')) != null && line != '') {
			let entry = parse_conntrack(line);
			if (entry)
				push(entries, entry);
		}
		file.close();
	}
	return {
		available: file != null,
		count: int(readfile('/proc/sys/net/netfilter/nf_conntrack_count') ?? '0'),
		max: int(readfile('/proc/sys/net/netfilter/nf_conntrack_max') ?? '0'),
		entries
	};
}

/* --- System log --------------------------------------------------------- */

function log_entry(id, time_ms, priority, source, msg) {
	let tag = match(msg, /^([^ :\[]+)(\[[0-9]+\])?: /);
	let facility = priority >> 3;
	return {
		id, time: time_ms, source,
		facility: FACILITIES[facility] ?? sprintf('local%d', facility - 16),
		severity: SEVERITIES[priority & 7],
		tag: tag?.[1],
		message: tag ? substr(msg, length(tag[0])) : msg
	};
}

function log_read(after, lines) {
	let bus = connect();
	let reply = bus?.call('log', 'read', { lines, stream: false, oneshot: true });
	if (reply == null)
		reply = bus?.call('log', 'read', { lines, stream: false });
	bus?.disconnect();
	if (type(reply?.log) == 'array') {
		let entries = [];
		for (let item in reply.log)
			if (item.id > after)
				push(entries, log_entry(item.id, item.time, item.priority, item.source == 0 ? 'kernel' : 'syslog', item.msg));
		return { mode: 'ubus', entries };
	}
	// Without logd's ubus API: the whole tail, without stable ids.
	let result = run(sprintf('logread -l %d 2>/dev/null', lines));
	let entries = [], id = 0;
	for (let line in split(result.output, '\n')) {
		let parts = match(line, /^(\S+ \S+ +\S+ \S+ \S+) ([a-z0-9]+)\.([a-z]+) (.*)$/);
		if (!parts)
			continue;
		let entry = log_entry(++id, null, 0, 'syslog', parts[4]);
		entry.time_text = parts[1];
		entry.facility = parts[2];
		entry.severity = parts[3];
		push(entries, entry);
	}
	return { mode: 'logread', entries };
}

/* --- Diagnostics ------------------------------------------------------- */

// Arguments reach a shell, so only plain host names and addresses pass.
// No leading '-', so a host can never be read as an option.
const HOST = /^[A-Za-z0-9:][A-Za-z0-9.:-]{0,252}$/;
const JOB = /^[0-9a-f]{16}$/;
const JOB_LIMIT = 8;
const RUNNER = '/usr/libexec/routerdeck/diag';

// Ping and Traceroute run as jobs outside rpcd (see libexec/routerdeck/diag),
// so a probe waiting for its timeout never holds up other calls.
function job_alive(dir) {
	let pid = trim(readfile(dir + '/pid') ?? '');
	return match(pid, /^[0-9]+$/) != null && index(readfile('/proc/' + pid + '/cmdline') ?? '', RUNNER) >= 0;
}

function job_remove(dir) {
	for (let name in lsdir(dir) ?? [])
		unlink(dir + '/' + name);
	rmdir(dir);
}

// Removes jobs nobody has read for two minutes and counts the running ones.
function job_sweep() {
	let running = 0;
	for (let id in lsdir(DIAG) ?? []) {
		let dir = DIAG + '/' + id;
		if (job_alive(dir))
			running++;
		else if (time() - (stat(dir + '/seen')?.mtime ?? 0) > 120)
			job_remove(dir);
	}
	return running;
}

function job_id() {
	let bytes = readfile('/dev/urandom', 8) ?? '', id = '';
	for (let i = 0; i < length(bytes); i++)
		id += sprintf('%02x', ord(bytes, i));
	return id;
}

function job_dir(args) {
	if (type(args.id) != 'string' || !match(args.id, JOB))
		return null;
	let dir = DIAG + '/' + args.id;
	return stat(dir)?.type == 'directory' ? dir : null;
}

// ucode treats a missing argument as 0 in comparisons; check the type first.
function int_in(value, low, high, fallback) {
	return type(value) == 'int' && value >= low && value <= high ? value : fallback;
}

const NETWORK = /^([0-9]{1,3}\.){3}[0-9]{1,3}\/(2[2-9]|30)$/;

// Creates the job directory with its arguments and extra files, then starts
// the runner in the background.
function job_start(job, files) {
	ensure_dirs();
	if (job_sweep() >= JOB_LIMIT)
		return failure('busy', 'Too many tools are running; stop one first');
	let id = job_id(), dir = DIAG + '/' + id;
	if (length(id) != 16 || !mkdir(dir, 0700))
		return failure('failed', 'Could not create the job');
	for (let name, text in files ?? {})
		writefile(dir + '/' + name, text);
	write_json(dir + '/args.json', { ...job, started: time() });
	writefile(dir + '/seen', sprintf('%d', time()));
	let code = system([ '/bin/sh', '-c', sprintf('%s %s </dev/null >/dev/null 2>&1 & echo $! >%s/pid', RUNNER, dir, dir) ]);
	if (code != 0) {
		job_remove(dir);
		return failure('failed', 'Could not start ' + job.tool);
	}
	return { ok: true, id, ...job };
}

function job_args(dir) {
	let args = read_json(dir + '/args.json', null);
	return type(args) == 'object' ? args : {};
}

// Running jobs, for the Scripts window's Jobs tab and the package lock.
function job_list() {
	let jobs = [];
	for (let id in lsdir(DIAG) ?? []) {
		let dir = DIAG + '/' + id;
		if (!job_alive(dir))
			continue;
		let args = job_args(dir);
		push(jobs, { id, tool: args.tool, started: args.started, host: args.host, name: args.name, operation: args.operation, names: args.names });
	}
	return jobs;
}

function diag_start(args) {
	if (!(args.tool in [ 'ping', 'traceroute', 'bandwidth', 'scan' ]))
		return failure('invalid', 'Unknown tool');
	if (args.tool == 'bandwidth' && !executable('/usr/bin/iperf3'))
		return failure('missing', 'Bandwidth tests need the iperf3 package');
	if (args.tool == 'scan' ? type(args.network) != 'string' || !match(args.network, NETWORK) : args.tool == 'bandwidth' && args.mode == 'server' ? false : type(args.host) != 'string' || !match(args.host, HOST))
		return failure('invalid', args.tool == 'scan' ? 'Enter a network from /22 to /30, such as 192.168.1.0/24' : 'Enter an address or host name');
	// Below 16 data bytes busybox ping cannot measure the round-trip time.
	return job_start({
		tool: args.tool, host: args.host, family: args.family == 4 || args.family == 6 ? args.family : 0,
		size: int_in(args.size, 16, 65500, 56), count: int_in(args.count, 0, 100000, 0),
		interval: int_in(args.interval, 200, 60000, 1000), timeout: int_in(args.timeout, 1, 10, 1),
		max: int_in(args.max, 1, 30, 15), protocol: args.protocol == 'udp' ? 'udp' : args.tool == 'bandwidth' ? 'tcp' : 'icmp',
		mode: args.mode == 'server' ? 'server' : 'client', direction: args.direction in [ 'receive', 'both' ] ? args.direction : 'send',
		duration: int_in(args.duration, 1, 300, 10), port: int_in(args.port, 1, 65535, 5201), bitrate: int_in(args.bitrate, 0, 10000000, 0),
		network: args.tool == 'scan' ? args.network : null
	});
}

// Returns the complete result lines from `from` on; a line still being
// written is left for the next read.
function diag_poll(args) {
	let dir = job_dir(args);
	if (!dir)
		return failure('gone', 'This job has ended');
	writefile(dir + '/seen', sprintf('%d', time()));
	let lines = split(readfile(dir + '/results') ?? '', '\n');
	let from = int_in(args.from, 0, length(lines), 0), results = [];
	for (let i = from; i < length(lines) - 1; i++) {
		try {
			push(results, json(lines[i]));
		}
		catch (e) {
			push(results, { error: 'parse', message: lines[i] });
		}
	}
	return { ok: true, running: job_alive(dir), results, next: max(from, length(lines) - 1) };
}

function diag(args) {
	if (args.action == 'start')
		return diag_start(args);
	if (args.action == 'poll')
		return diag_poll(args);
	if (args.action == 'list')
		return { ok: true, now: time(), jobs: job_list() };
	if (args.action == 'stop') {
		let dir = job_dir(args);
		// Package operations and scripts are changes: Task stops scripts,
		// and nothing interrupts a package manager halfway.
		if (dir && job_args(dir).tool in [ 'package', 'script' ])
			return failure('denied', 'Stop scripts from the Scripts window');
		if (dir) {
			writefile(dir + '/stop', '');
			// A tool waiting for input (an iperf3 server) is ended directly.
			let child = trim(readfile(dir + '/child.pid') ?? '');
			if (match(child, /^[0-9]+$/))
				system([ 'kill', child ]);
		}
		return { ok: true };
	}
	return failure('invalid', 'Unknown action');
}

/* --- Neighbours, routing rules, WireGuard ------------------------------ */

// `ip neigh` prints the same text with ip-full and busybox:
// ADDRESS dev DEV [lladdr MAC] [router] STATE
function neighbors() {
	let list = [];
	for (let family in [ 4, 6 ]) {
		for (let line in split(run(sprintf('ip -%d neigh', family)).output, '\n')) {
			let words = split(trim(line), /\s+/);
			if (length(words) < 3 || words[1] != 'dev')
				continue;
			let entry = { family, address: words[0], dev: words[2], router: false, state: words[length(words) - 1] };
			for (let i = 3; i < length(words); i++) {
				if (words[i] == 'lladdr')
					entry.mac = words[++i];
				else if (words[i] == 'router')
					entry.router = true;
			}
			push(list, entry);
		}
	}
	return { neighbors: list };
}

// PRIORITY: [not] from SRC [to DST] [fwmark M] [iif X] [oif Y] lookup T | ACTION
function rules() {
	let list = [];
	for (let family in [ 4, 6 ]) {
		for (let line in split(run(sprintf('ip -%d rule', family)).output, '\n')) {
			let head = match(line, /^([0-9]+):\s+(.*)$/);
			if (!head)
				continue;
			let words = split(trim(head[2]), /\s+/);
			let rule = { family, priority: int(head[1]) };
			for (let i = 0; i < length(words); i++) {
				let word = words[i];
				if (word == 'not') rule.invert = true;
				else if (word in [ 'from', 'to', 'fwmark', 'iif', 'oif', 'lookup', 'goto', 'tos', 'uidrange', 'ipproto', 'sport', 'dport', 'suppress_prefixlength' ]) rule[word] = words[++i];
				else if (word in [ 'blackhole', 'prohibit', 'unreachable' ]) rule.action = word;
			}
			push(list, rule);
		}
	}
	return { rules: list };
}

const WG_KEY = /^[A-Za-z0-9+\/]{42}[AEIMQUYcgkosw480]=$/;

// `wg show all dump` without private and preshared keys: the console
// never needs them back.
function wireguard() {
	if (!executable('/usr/bin/wg'))
		return { available: false, interfaces: {} };
	let interfaces = {};
	for (let line in split(run('wg show all dump').output, '\n')) {
		let fields = split(line, '\t');
		if (length(fields) == 5)
			interfaces[fields[0]] = { public_key: fields[2], listen_port: int(fields[3]), peers: [] };
		else if (length(fields) == 9 && interfaces[fields[0]])
			push(interfaces[fields[0]].peers, {
				public_key: fields[1], preshared: fields[2] != '(none)', endpoint: fields[3] == '(none)' ? null : fields[3],
				allowed_ips: fields[4] == '(none)' ? [] : split(fields[4], ','), latest_handshake: int(fields[5]),
				rx_bytes: int(fields[6]), tx_bytes: int(fields[7]), keepalive: fields[8] == 'off' ? null : int(fields[8])
			});
	}
	return { available: true, now: time(), interfaces };
}

function wireguard_key() {
	let key = trim(run('wg genkey').output);
	return match(key, WG_KEY) ? key : null;
}

/* --- UPnP, dynamic DNS, queues -------------------------------------- */

// miniupnpd's lease file: PROTO:EXT_PORT:INT_ADDR:INT_PORT:EXPIRES:DESCRIPTION
function upnp() {
	let ctx = cursor();
	ctx.load('upnpd');
	let file = ctx.get('upnpd', 'config', 'upnp_lease_file') ?? '/var/run/miniupnpd.leases';
	let mappings = [];
	for (let line in split(readfile(file) ?? '', '\n')) {
		let fields = match(line, /^([A-Z]+):([0-9]+):([^:]+):([0-9]+):([0-9]+):(.*)$/);
		if (fields)
			push(mappings, { protocol: fields[1], external_port: int(fields[2]), address: fields[3], internal_port: int(fields[4]), expires: int(fields[5]), description: fields[6] });
	}
	return { installed: executable('/usr/sbin/miniupnpd'), now: time(), mappings };
}

// ddns-scripts writes the last registered address and update time per
// service section into its run directory.
function ddns() {
	let ctx = cursor();
	ctx.load('ddns');
	let rundir = ctx.get('ddns', 'global', 'ddns_rundir') ?? '/var/run/ddns';
	let services = {};
	ctx.foreach('ddns', 'service', section => {
		let name = section['.name'];
		let pid = trim(readfile(rundir + '/' + name + '.pid') ?? '');
		services[name] = {
			ip: trim(readfile(rundir + '/' + name + '.ip') ?? '') || null,
			updated: int(trim(readfile(rundir + '/' + name + '.update') ?? '0')) || null,
			running: match(pid, /^[0-9]+$/) != null && access('/proc/' + pid)
		};
	});
	let providers = [];
	for (let dir in [ '/usr/share/ddns/default', '/usr/share/ddns/custom' ])
		for (let file in lsdir(dir) ?? [])
			if (match(file, /\.json$/))
				push(providers, replace(file, /\.json$/, ''));
	return { installed: executable('/usr/lib/ddns/dynamic_dns_updater.sh'), now: time(), services, providers: sort(uniq(providers)) };
}

// Root queueing disciplines per device, as SQM leaves them.
function qdisc() {
	let devices = {}, current = null;
	for (let line in split(run('tc -s qdisc show').output, '\n')) {
		let head = match(line, /^qdisc ([^ ]+) ([^ ]+) dev ([^ ]+) (root|parent [^ ]+)/);
		if (head) {
			current = head[4] == 'root' ? { kind: head[1], handle: head[2] } : null;
			if (current)
				devices[head[3]] = current;
			continue;
		}
		let sent = current ? match(line, /^ Sent ([0-9]+) bytes ([0-9]+) pkt \(dropped ([0-9]+)/) : null;
		if (sent) {
			current.bytes = int(sent[1]);
			current.packets = int(sent[2]);
			current.dropped = int(sent[3]);
		}
	}
	return { devices };
}

/* --- Netwatch and Wake on LAN ----------------------------------------- */

function netwatch() {
	let state = read_json(RUN + '/netwatch.json', null);
	return { running: state != null && time() - (state.now ?? 0) < 15, now: time(), hosts: state?.hosts ?? {} };
}

const MAC = /^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$/;
const DEVICE = /^[A-Za-z0-9_.@-]{1,15}$/;

function wol(args) {
	if (!executable('/usr/bin/etherwake'))
		return failure('missing', 'Wake on LAN needs the etherwake package');
	if (type(args.mac) != 'string' || !match(args.mac, MAC))
		return failure('invalid', 'Enter a MAC address such as 00:11:22:33:44:55');
	if (type(args.interface) != 'string' || !match(args.interface, DEVICE))
		return failure('invalid', 'Choose the device the computer is on');
	let result = run(sprintf('etherwake -i %s %s', args.interface, args.mac));
	return result.code == 0 ? { ok: true } : failure('failed', trim(result.output) || 'etherwake failed');
}

/* --- Packages and scheduler ------------------------------------------- */

function apk_world() {
	let world = {};
	for (let line in split(readfile('/etc/apk/world') ?? '', '\n')) {
		let name = match(trim(line), /^([^<>=~ ]+)/);
		if (name)
			world[name[1]] = true;
	}
	return world;
}

function field_of(text, key) {
	for (let line in split(text ?? '', '\n'))
		if (substr(line, 0, length(key) + 2) == key + ': ')
			return substr(line, length(key) + 2);
	return null;
}

// Newer versions in the package lists from the last update; the lists live
// in RAM, so after a reboot there are none until the next update. apk names
// a package with its version ("name-1.2-r1"), so the name is the longest
// installed name the old version starts with.
function upgradable(manager, installed) {
	// While a package operation runs, the last list is shown: opkg would
	// refuse the operation if listing updates held its lock.
	for (let job in job_list())
		if (job.tool == 'package')
			return read_json(RUN + '/upgradable.json', {});
	let found = {};
	if (manager == 'apk') {
		for (let line in split(run('apk list --upgradable 2>/dev/null').output, '\n')) {
			// POSIX brackets take no escapes, so the closing "]" is trimmed.
			let item = match(line, /^([^ ]+) .*\[upgradable from: ([^ ]+)$/);
			if (!item)
				continue;
			item[2] = rtrim(item[2], ']');
			for (let i = length(item[2]) - 2; i > 0; i--) {
				let name = substr(item[2], 0, i);
				if (substr(item[2], i, 1) == '-' && match(substr(item[2], i + 1, 1), /[0-9]/) && installed[name] && substr(item[1], 0, i + 1) == name + '-') {
					found[name] = substr(item[1], i + 1);
					break;
				}
			}
		}
	}
	else {
		for (let line in split(run('opkg list-upgradable 2>/dev/null').output, '\n')) {
			let item = match(line, /^([^ ]+) - ([^ ]+) - ([^ ]+)$/);
			if (item)
				found[item[1]] = item[3];
		}
	}
	write_json(RUN + '/upgradable.json', found);
	return found;
}

function names_of(list) {
	let names = {};
	for (let entry in list)
		names[entry.name] = true;
	return names;
}

// Installed packages from apk's database (25.12) or opkg's status (24.10).
function packages() {
	let list = [];
	let db = readfile('/lib/apk/db/installed');
	if (db != null) {
		let world = apk_world();
		for (let record in split(db, '\n\n')) {
			let entry = {};
			for (let line in split(record, '\n')) {
				if (substr(line, 1, 1) != ':')
					continue;
				let key = substr(line, 0, 1), value = substr(line, 2);
				if (key == 'P') entry.name = value;
				else if (key == 'V') entry.version = value;
				else if (key == 'I') entry.size = int(value);
				else if (key == 'T') entry.description = value;
			}
			if (entry.name) {
				entry.requested = !!world[entry.name];
				push(list, entry);
			}
		}
		return { manager: 'apk', packages: list, upgradable: upgradable('apk', names_of(list)) };
	}
	let status = readfile('/usr/lib/opkg/status');
	if (status != null) {
		for (let record in split(status, '\n\n')) {
			let name = field_of(record, 'Package');
			if (!name || index(field_of(record, 'Status') ?? '', 'installed') < 0)
				continue;
			let control = readfile('/usr/lib/opkg/info/' + name + '.control');
			push(list, {
				name, version: field_of(record, 'Version'), requested: index(field_of(record, 'Status') ?? '', 'user') >= 0,
				size: int(field_of(control, 'Installed-Size') ?? '0') || null, description: field_of(control, 'Description')
			});
		}
		return { manager: 'opkg', packages: list, upgradable: upgradable('opkg', names_of(list)) };
	}
	return { manager: null, packages: [] };
}

/* --- Package operations and scripts ------------------------------------ */

const PACKAGE = /^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$/;
const OPERATIONS = [ 'update', 'install', 'remove', 'upgrade' ];

function package_manager() {
	if (executable('/usr/bin/apk'))
		return 'apk';
	if (executable('/bin/opkg') || executable('/usr/bin/opkg'))
		return 'opkg';
	return null;
}

// A script's commands run as children of its shell and keep its output
// open, so Stop ends the whole tree, children first.
function kill_tree(pid) {
	let children = {};
	for (let name in lsdir('/proc') ?? []) {
		let parent = match(readfile('/proc/' + name + '/stat') ?? '', /^[0-9]+ \(.*\) [A-Za-z] ([0-9]+)/);
		if (parent && match(name, /^[0-9]+$/))
			push(children[parent[1]] ??= [], name);
	}
	let order = [], queue = [ pid ];
	while (length(queue)) {
		let next = shift(queue);
		unshift(order, next);
		push(queue, ...(children[next] ?? []));
	}
	for (let target in order)
		system([ 'kill', target ]);
}

// Package operations and scripts run as jobs like Ping, with their output
// streamed line by line. Only one package operation runs at a time: both
// package managers lock their database.
function task(args) {
	if (args.action == 'stop') {
		let dir = job_dir(args);
		let child = dir && job_args(dir).tool == 'script' ? trim(readfile(dir + '/child.pid') ?? '') : '';
		if (match(child, /^[0-9]+$/)) {
			writefile(dir + '/stop', '');
			kill_tree(child);
		}
		return { ok: true };
	}
	if (args.tool == 'package') {
		let manager = package_manager();
		if (!manager)
			return failure('missing', 'This router has no package manager');
		if (!(args.operation in OPERATIONS))
			return failure('invalid', 'Unknown package operation');
		let names = args.operation == 'update' ? [] : type(args.names) == 'array' ? args.names : [];
		if (args.operation != 'update' && (!length(names) || length(names) > 50 || length(filter(names, name => type(name) != 'string' || !match(name, PACKAGE)))))
			return failure('invalid', 'Enter package names such as tcpdump');
		for (let job in job_list())
			if (job.tool == 'package')
				return failure('busy', 'Another package operation is running; wait for it to finish');
		return job_start({ tool: 'package', manager, operation: args.operation, names });
	}
	if (args.tool == 'script') {
		if (type(args.name) != 'string' || !match(args.name, NAME))
			return failure('invalid', 'Choose a script');
		let ctx = cursor();
		ctx.load('routerdeck');
		if (ctx.get('routerdeck', args.name) != 'script')
			return failure('missing', sprintf('There is no script %s', args.name));
		return job_start({ tool: 'script', name: args.name }, { 'script.sh': ctx.get('routerdeck', args.name, 'source') ?? '' });
	}
	return failure('invalid', 'Unknown task');
}

/* --- Files ------------------------------------------------------------- */

// Absolute paths without "." or ".." segments.
function clean_path(path) {
	if (type(path) != 'string' || substr(path, 0, 1) != '/' || length(path) > 1024 || index(path, '\0') >= 0)
		return null;
	let parts = filter(split(path, '/'), part => part != '' && part != '.');
	if ('..' in parts)
		return null;
	return '/' + join('/', parts);
}

// Kernel and device file systems, and the read-only image, are never changed.
const PROTECTED = /^\/(proc|sys|dev|rom)(\/|$)/;
const FILE_LIMIT = 2000;

function files(args) {
	let path = clean_path(args.path ?? '/');
	if (!path)
		return failure('invalid', 'Enter an absolute path such as /tmp');
	if (stat(path)?.type != 'directory')
		return failure('missing', sprintf('%s is not a directory', path));
	let entries = [], names = lsdir(path) ?? [];
	for (let name in slice(sort(names), 0, FILE_LIMIT)) {
		let full = (path == '/' ? '' : path) + '/' + name;
		let info = lstat(full);
		if (!info)
			continue;
		let entry = { name, type: info.type, size: info.size, mtime: info.mtime, mode: info.mode & 4095 };
		if (info.type == 'link') {
			entry.link = readlink(full);
			entry.target = stat(full)?.type;
		}
		push(entries, entry);
	}
	return { ok: true, path, entries, truncated: length(names) > FILE_LIMIT };
}

function file_remove(args) {
	let path = clean_path(args.path);
	if (!path || path == '/' || match(path, PROTECTED))
		return failure('denied', sprintf('%s cannot be removed here', args.path));
	let info = lstat(path);
	if (!info)
		return failure('missing', sprintf('%s no longer exists', path));
	if (info.type == 'directory') {
		if (length(lsdir(path) ?? []))
			return failure('not-empty', sprintf('%s is not empty', path));
		return rmdir(path) ? { ok: true } : failure('failed', sprintf('Could not remove %s', path));
	}
	return unlink(path) ? { ok: true } : failure('failed', sprintf('Could not remove %s', path));
}

function file_mkdir(args) {
	let path = clean_path(args.path);
	if (!path || match(path, PROTECTED))
		return failure('denied', sprintf('%s cannot be created here', args.path));
	if (lstat(path))
		return failure('exists', sprintf('%s already exists', path));
	return mkdir(path, 0755) ? { ok: true } : failure('failed', sprintf('Could not create %s', path));
}

/* --- Backup restore, firmware and reset ---------------------------------- */

// The console uploads files here with cgi-io, as LuCI does to its own names.
const UPLOADS = { backup: '/tmp/routerdeck-backup.tar.gz', firmware: '/tmp/routerdeck-firmware.bin' };

function restore(args) {
	let file = UPLOADS.backup;
	if (args.action == 'discard') {
		unlink(file);
		return { ok: true };
	}
	if (!access(file))
		return failure('missing', 'Upload a backup first');
	let listing = run(sprintf('tar -tzf %s', file));
	let names = filter(split(listing.output, '\n'), length);
	if (listing.code != 0 || !length(filter(names, name => match(name, /^(\.\/)?etc\//)))) {
		unlink(file);
		return failure('invalid', 'This is not a configuration backup (a .tar.gz of files from /etc)');
	}
	if (args.action == 'check')
		return { ok: true, size: stat(file)?.size, count: length(names), files: slice(names, 0, 500) };
	if (args.action != 'apply')
		return failure('invalid', 'Unknown action');
	if (safe_state())
		return failure('safemode', 'Leave Safe Mode before restoring a backup');
	let result = run(sprintf('/sbin/sysupgrade -r %s', file));
	if (result.code != 0)
		return failure('failed', trim(result.output) || 'sysupgrade could not restore the backup');
	unlink(file);
	log_message('Configuration restored from a backup; rebooting');
	system('(sleep 2; /sbin/reboot) >/dev/null 2>&1 &');
	return { ok: true, rebooting: true };
}

function firmware(args) {
	let file = UPLOADS.firmware;
	if (args.action == 'discard') {
		unlink(file);
		return { ok: true };
	}
	if (!access(file))
		return failure('missing', 'Upload a firmware image first');
	let bus = connect();
	let check = bus?.call('system', 'validate_firmware_image', { path: file });
	bus?.disconnect();
	if (args.action == 'check') {
		let sum = match(run(sprintf('sha256sum %s', file)).output, /^([0-9a-f]{64})/);
		return { ok: true, size: stat(file)?.size, sha256: sum?.[1], valid: check?.valid == true, forceable: check?.forceable == true, allow_backup: check?.allow_backup != false, tests: check?.tests ?? {} };
	}
	if (args.action != 'flash')
		return failure('invalid', 'Unknown action');
	// The console never forces an image the router itself rejects.
	if (check?.valid != true)
		return failure('invalid', 'The router rejected this image, so it is not flashed');
	if (safe_state())
		return failure('safemode', 'Leave Safe Mode before flashing firmware');
	let keep = args.keep != false && check.allow_backup != false;
	log_message(sprintf('Flashing new firmware, %s the configuration', keep ? 'keeping' : 'without'));
	system(sprintf('(sleep 1; /sbin/sysupgrade %s%s) >/dev/null 2>&1 &', keep ? '' : '-n ', file));
	return { ok: true, keep };
}

// firstboot needs the overlay of squashfs images; on a writable root file
// system there is no factory state to go back to.
function reset() {
	if (safe_state())
		return failure('safemode', 'Leave Safe Mode before resetting the configuration');
	if (index(readfile('/proc/mounts') ?? '', ' /overlay ') < 0)
		return failure('unsupported', 'This router keeps its root file system writable instead of on an overlay, so it has no factory defaults to reset to');
	log_message('Resetting the configuration to the defaults; rebooting');
	system('(sleep 1; /sbin/firstboot -y && /sbin/reboot) >/dev/null 2>&1 &');
	return { ok: true, rebooting: true };
}

/* --- Kernel settings ------------------------------------------------------ */

// Current values of the settings IP > Settings shows, and the file that
// sets them.
function sysctl(args) {
	let values = {};
	for (let key in type(args.keys) == 'array' ? slice(args.keys, 0, 64) : [])
		if (type(key) == 'string' && match(key, /^[a-z0-9_]+(\.[a-z0-9_-]+)+$/)) {
			let value = readfile(sysctl_path(key));
			if (value != null)
				values[key] = trim(value);
		}
	return { values, text: config_text('sysctl'), path: FILES.sysctl };
}

/* --- Users, certificates, LEDs and disks ------------------------------- */

// rpcd logins without their password hashes: only what kind of password a
// login has. rpcd reads them at every login, so changes need no reload.
function password_kind(value) {
	if (value == null || value == '')
		return 'none';
	let account = match(value, /^\$p\$(.+)$/);
	if (account)
		return 'system:' + account[1];
	return match(value, /^\$[156]\$/) ? 'hash' : 'other';
}

function users(request) {
	let ctx = cursor(), logins = [];
	ctx.load('rpcd');
	ctx.foreach('rpcd', 'login', section => {
		push(logins, {
			section: section['.name'], username: section.username, password: password_kind(section.password),
			read: type(section.read) == 'array' ? section.read : section.read ? [ section.read ] : [],
			write: type(section.write) == 'array' ? section.write : section.write ? [ section.write ] : [],
			comment: section.comment
		});
	});
	let groups = {};
	for (let file in lsdir('/usr/share/rpcd/acl.d') ?? []) {
		let acl = read_json('/usr/share/rpcd/acl.d/' + file, {});
		for (let name, group in (type(acl) == 'object' ? acl : {}))
			groups[name] = type(group?.description) == 'string' ? group.description : '';
	}
	let accounts = [];
	for (let line in split(readfile('/etc/passwd') ?? '', '\n')) {
		let fields = split(line, ':');
		if (length(fields) >= 7)
			push(accounts, { name: fields[0], uid: int(fields[2]), shell: fields[6] });
	}
	return { current: user_of(request), logins, groups, accounts };
}

const CA_BUNDLE = '/etc/ssl/certs/ca-certificates.crt';
const CERT_UPLOADS = { cert: '/tmp/routerdeck-cert', key: '/tmp/routerdeck-key' };

// Paths reach a shell, so only plain ones are used.
function web_files() {
	let ctx = cursor();
	ctx.load('uhttpd');
	let path = (option, fallback) => {
		let value = ctx.get('uhttpd', 'main', option);
		return type(value) == 'string' && match(value, /^\/[A-Za-z0-9._\/-]+$/) ? value : fallback;
	};
	return { cert: path('cert', '/etc/uhttpd.crt'), key: path('key', '/etc/uhttpd.key') };
}

// The web server's certificate and those of ACME clients, as file bytes in
// base64; the console parses them.
function certificates() {
	let web = web_files(), list = [];
	let add = (path, role, key) => {
		let data = readfile(path);
		if (data != null && length(data) <= 262144)
			push(list, { path, role, data: b64enc(data), key: key != null && access(key) == true, keypath: key, previous: role == 'web' && access(path + '.old') == true });
	};
	add(web.cert, 'web', web.key);
	for (let dir in [ '/etc/ssl/acme', '/etc/acme' ])
		for (let file in lsdir(dir) ?? [])
			if (match(file, /\.(crt|cer|pem)$/) && !match(file, /(key|csr)/))
				add(dir + '/' + file, 'acme', null);
	return { certificates: list, px5g: executable('/usr/sbin/px5g') };
}

function trusted() {
	let data = readfile(CA_BUNDLE);
	return { path: CA_BUNDLE, data: data != null && length(data) <= 1048576 ? b64enc(data) : null };
}

// uhttpd reads its certificate at start; the restart waits until this call
// has answered, since it ends the connection the answer goes out on.
function restart_web() {
	system('(sleep 1; /etc/init.d/uhttpd restart) >/dev/null 2>&1 &');
}

const SUBJECT = /^[A-Za-z0-9 ._-]{0,64}$/;
const PEM_CERTS = /-----BEGIN CERTIFICATE-----[^-]+-----END CERTIFICATE-----/g;
const PEM_KEY = /-----BEGIN ([A-Z]+ )?PRIVATE KEY-----[^-]+-----END ([A-Z]+ )?PRIVATE KEY-----/;

// The uploaded certificate (PEM, possibly with its chain and key, or DER)
// and key (PEM or DER), as they will be installed.
function uploaded_certificate() {
	let cert = readfile(CERT_UPLOADS.cert), key = readfile(CERT_UPLOADS.key);
	if (cert == null)
		return null;
	if (index(cert, '-----BEGIN') >= 0) {
		let chain = match(cert, PEM_CERTS);
		let pem_key = match(cert, PEM_KEY) ?? match(key ?? '', PEM_KEY);
		return length(chain) ? { cert: join('\n', map(chain, block => block[0])) + '\n', key: pem_key ? pem_key[0] + '\n' : key } : null;
	}
	return { cert, key: key != null && index(key, '-----BEGIN') >= 0 ? (match(key, PEM_KEY)?.[0] ?? null) : key };
}

function certificate(args) {
	let web = web_files();
	if (args.action == 'discard') {
		unlink(CERT_UPLOADS.cert);
		unlink(CERT_UPLOADS.key);
		return { ok: true };
	}
	if (args.action == 'regenerate') {
		if (!executable('/usr/sbin/px5g'))
			return failure('missing', 'Making a certificate needs px5g (px5g-mbedtls or px5g-wolfssl)');
		let ctx = cursor();
		ctx.load('uhttpd');
		let option = (name, fallback) => {
			let value = ctx.get('uhttpd', 'defaults', name) ?? fallback;
			return match(value, SUBJECT) ? value : fallback;
		};
		let host = trim(readfile('/proc/sys/kernel/hostname') ?? 'OpenWrt');
		let common = match(host, SUBJECT) ? host : option('commonname', 'OpenWrt');
		let keyopt = option('key_type', 'ec') == 'ec' ? 'ec -pkeyopt ec_paramgen_curve:' + option('ec_curve', 'P-256') : 'rsa:' + int(option('bits', '2048'));
		let result = run(sprintf("/usr/sbin/px5g selfsigned -der -days %d -newkey %s -keyout '%s.new' -out '%s.new' -subj '/C=%s/ST=%s/L=%s/O=%s/CN=%s' -addext extendedKeyUsage=serverAuth -addext subjectAltName=DNS:%s",
			int(option('days', '397')), keyopt, web.key, web.cert, option('country', 'ZZ'), option('state', 'Somewhere'), option('location', 'Unknown'), option('organization', 'OpenWrt'), common, common));
		if (result.code != 0 || !access(web.cert + '.new') || !access(web.key + '.new')) {
			unlink(web.cert + '.new');
			unlink(web.key + '.new');
			return failure('failed', trim(result.output) || 'px5g could not make a certificate');
		}
		system(sprintf("cp '%s' '%s.old'; cp '%s' '%s.old'; mv '%s.new' '%s'; mv '%s.new' '%s'", web.cert, web.cert, web.key, web.key, web.cert, web.cert, web.key, web.key));
		log_message('New self-signed web server certificate for ' + common);
		restart_web();
		return { ok: true };
	}
	if (args.action == 'previous') {
		if (!access(web.cert + '.old') || !access(web.key + '.old'))
			return failure('missing', 'There is no previous certificate');
		system(sprintf("mv '%s' '%s.tmp'; mv '%s' '%s.tmp'; mv '%s.old' '%s'; mv '%s.old' '%s'; mv '%s.tmp' '%s.old'; mv '%s.tmp' '%s.old'",
			web.cert, web.cert, web.key, web.key, web.cert, web.cert, web.key, web.key, web.cert, web.cert, web.key, web.key));
		restart_web();
		return { ok: true };
	}
	let found = uploaded_certificate();
	if (!found) {
		unlink(CERT_UPLOADS.cert);
		unlink(CERT_UPLOADS.key);
		return failure('invalid', 'Choose a certificate (PEM or DER) and its private key');
	}
	if (args.action == 'check')
		return { ok: true, data: b64enc(found.cert), key: found.key != null && length(found.key) > 0 };
	if (args.action != 'import')
		return failure('invalid', 'Unknown action');
	if (!found.key)
		return failure('invalid', 'The private key is missing; choose the certificate and its key together');
	system(sprintf("cp '%s' '%s.old'; cp '%s' '%s.old'", web.cert, web.cert, web.key, web.key));
	writefile(web.cert, found.cert);
	writefile(web.key, found.key);
	system([ 'chmod', '600', web.key ]);
	unlink(CERT_UPLOADS.cert);
	unlink(CERT_UPLOADS.key);
	log_message('Imported a web server certificate');
	restart_web();
	return { ok: true };
}

// LEDs in sysfs with their triggers; the current one is in brackets.
function leds() {
	let list = [];
	for (let name in sort(lsdir('/sys/class/leds') ?? [])) {
		let dir = '/sys/class/leds/' + name, current = null;
		let triggers = map(filter(split(trim(readfile(dir + '/trigger') ?? ''), /\s+/), length), word => {
			let selected = match(word, /^\[(.+)\]$/);
			if (selected)
				current = selected[1];
			return selected ? selected[1] : word;
		});
		push(list, { name, brightness: int(trim(readfile(dir + '/brightness') ?? '0')), max: int(trim(readfile(dir + '/max_brightness') ?? '1')), trigger: current, triggers });
	}
	return { leds: list };
}

// Mounts are written with octal escapes for spaces and the like.
const unescape_mount = text => replace(text, /\\([0-7]{3})/g, (all, code) => chr(int(code, 8)));

function disks() {
	let mounts = [];
	for (let line in split(readfile('/proc/mounts') ?? '', '\n')) {
		let words = split(line, ' ');
		if (length(words) >= 4)
			push(mounts, { source: words[0], target: unescape_mount(words[1]), fstype: words[2], options: words[3] });
	}
	let usage = {};
	for (let line in split(run('df -kP').output, '\n')) {
		let words = match(line, /^[^ ]+ +([0-9]+) +([0-9]+) +([0-9]+) +[0-9]+% +(.+)$/);
		if (words)
			usage[words[4]] = { size: int(words[1]) * 1024, used: int(words[2]) * 1024, available: int(words[3]) * 1024 };
	}
	let block = executable('/sbin/block');
	let filesystems = {};
	for (let line in split(run(block ? '/sbin/block info' : 'blkid').output, '\n')) {
		let head = match(line, /^([^:]+): (.*)$/);
		if (!head)
			continue;
		let entry = {};
		for (let pair in match(head[2], /([A-Z_]+)="([^"]*)"/g))
			entry[lc(pair[1])] = pair[2];
		filesystems[head[1]] = entry;
	}
	let devices = [];
	for (let name in sort(lsdir('/sys/block') ?? [])) {
		// Loop and RAM devices only count when they hold a file system.
		if (match(name, /^(loop|ram|zram|nbd)/) && !filesystems['/dev/' + name])
			continue;
		let dir = '/sys/block/' + name;
		let device = {
			name, size: int(trim(readfile(dir + '/size') ?? '0')) * 512, removable: trim(readfile(dir + '/removable') ?? '0') == '1',
			model: trim(readfile(dir + '/device/model') ?? ''), vendor: trim(readfile(dir + '/device/vendor') ?? ''), partitions: []
		};
		for (let part in sort(lsdir(dir) ?? []))
			if (access(dir + '/' + part + '/partition'))
				push(device.partitions, { name: part, size: int(trim(readfile(dir + '/' + part + '/size') ?? '0')) * 512 });
		push(devices, device);
	}
	let swaps = [];
	for (let line in slice(split(readfile('/proc/swaps') ?? '', '\n'), 1)) {
		let words = split(trim(line), /\s+/);
		if (length(words) >= 4)
			push(swaps, { source: words[0], size: int(words[2]) * 1024, used: int(words[3]) * 1024 });
	}
	return { block, devices, filesystems, mounts, usage, swaps };
}

// File systems the router itself needs stay mounted.
const SYSTEM_MOUNTS = /^\/(|rom|overlay|tmp|tmp\/.*|dev|dev\/.*|proc|proc\/.*|sys|sys\/.*|boot)$/;

function unmount(args) {
	let target = clean_path(args.target);
	if (!target || match(target, SYSTEM_MOUNTS))
		return failure('denied', sprintf('%s stays mounted', args.target));
	if (index(readfile('/proc/mounts') ?? '', ' ' + target + ' ') < 0)
		return failure('missing', sprintf('Nothing is mounted at %s', target));
	let result = run(sprintf("umount '%s'", target));
	return result.code == 0 ? { ok: true } : failure('busy', trim(result.output) || sprintf('%s is in use', target));
}

function mount_all() {
	if (!executable('/sbin/block'))
		return failure('missing', 'Mounting needs the block-mount package');
	let result = run('/sbin/block mount');
	return result.code == 0 ? { ok: true } : failure('failed', trim(result.output) || 'block mount failed');
}

/* --- Terminal ----------------------------------------------------------- */

function terminal() {
	let ctx = cursor();
	let section = null;
	ctx.load('ttyd');
	ctx.foreach('ttyd', 'ttyd', s => { section ??= s; });
	let bus = connect();
	let services = bus?.call('service', 'list', { name: 'ttyd' }) ?? {};
	bus?.disconnect();
	let running = false;
	for (let name, instance in services?.ttyd?.instances ?? {})
		running ||= !!instance.running;
	return {
		installed: ttyd_installed(),
		running,
		port: int(section?.port ?? '7681'),
		ssl: section?.ssl == '1',
		interface: section?.interface,
		url_override: section?.url_override
	};
}

/* --- Safe Mode helpers -------------------------------------------------- */

function watchdog(action) {
	return system([ '/etc/init.d/routerdeck-safemode', action ]) == 0;
}

function write_heartbeat() {
	write_json(SAFE + '/heartbeat', time());
}

function release_safe(restore) {
	let state = safe_state();
	if (!state)
		return [];
	watchdog('stop');
	if (restore)
		return safe_restore(state, 'exited without keeping changes');
	history_save(map(history_load(), entry => ({ ...entry, safemode: false })));
	safe_clear();
	log_message('Safe Mode released; changes kept');
	return [];
}

/* --- Changes, history and undo ------------------------------------------ */

// fw4 skips invalid sections with a warning and still exits 0, so problems
// are found by comparing its warnings before and after a change. Section
// indices are removed because inserting a rule shifts them.
function fw_problems() {
	let result = run('fw4 check 2>&1');
	let problems = [];
	for (let line in split(result.output, '\n'))
		if (substr(line, 0, 3) == '[!]' && match(line, /invalid|skipped|unknown/))
			push(problems, line);
	return { code: result.code, problems, output: trim(result.output) };
}

function new_problems(before, after) {
	let known = map(before.problems, line => replace(line, /@[a-z_]+\[[0-9]+\]/g, '@'));
	return filter(after.problems, line => !(replace(line, /@[a-z_]+\[[0-9]+\]/g, '@') in known));
}

// Values are one line, except the source of a script.
function valid_value(value, multiline) {
	if (type(value) == 'string')
		return length(value) <= (multiline ? 65536 : 4096) && (multiline || index(value, '\n') < 0);
	if (type(value) != 'array' || length(value) > 256)
		return false;
	for (let item in value)
		if (type(item) != 'string' || length(item) > 4096 || index(item, '\n') >= 0)
			return false;
	return true;
}

// Operations: add {config,type,name?,ref?,values}, set {config,section,values},
// unset {config,section,options}, delete {config,section},
// order {config,sections}. A `$ref` names a section added earlier.
function stage(ctx, ops) {
	let created = {}, touched = [], files = {};
	let section_of = name => type(name) == 'string' && substr(name, 0, 1) == '$' ? created[name] : name;
	let exists = (config, name) => type(name) == 'string' && match(name, NAME) && ctx.get(config, name) != null;
	for (let op in ops) {
		let config = op?.config;
		if (!(config in CONFIGS))
			return failure('invalid', sprintf('Configuration %s cannot be changed here', config));
		// Plain files are replaced as a whole, and only if nobody changed
		// them since the client read them.
		if (FILES[config]) {
			if (op.op != 'text' || type(op.text) != 'string' || length(op.text) > 65536 || index(op.text, '\0') >= 0)
				return failure('invalid', sprintf('%s takes a text', config));
			if (op.expect != null && op.expect != config_text(config))
				return failure('conflict', sprintf('%s was changed meanwhile; look again and repeat the change', config));
			files[config] = op.text;
			continue;
		}
		if (!(config in touched)) {
			// Like the uci command, a change creates a missing configuration.
			if (!access('/etc/config/' + config))
				writefile('/etc/config/' + config, '');
			ctx.load(config);
			push(touched, config);
		}
		let values = op.values ?? {};
		if (type(values) != 'object')
			return failure('invalid', 'Values must be an object');
		for (let key, value in values)
			if (!match(key, NAME) || !(value == null || valid_value(value, config == 'routerdeck' && key == 'source')))
				return failure('invalid', sprintf('Invalid value for %s', key));

		let section;
		if (op.op == 'add') {
			if (type(op.type) != 'string' || !match(op.type, TYPE))
				return failure('invalid', 'Invalid section type');
			if (op.name != null) {
				if (type(op.name) != 'string' || !match(op.name, NAME) || ctx.get(config, op.name) != null)
					return failure('exists', sprintf('%s already exists', op.name));
				ctx.set(config, op.name, op.type);
				section = op.name;
			}
			else
				section = ctx.add(config, op.type);
			if (op.ref != null)
				created[op.ref] = section;
		}
		else if (op.op in [ 'set', 'unset', 'delete' ]) {
			section = section_of(op.section);
			if (!exists(config, section))
				return failure('missing', sprintf('%s %s no longer exists', config, op.section));
			if (op.op == 'delete') {
				ctx.delete(config, section);
				continue;
			}
			if (op.op == 'unset') {
				for (let option in op.options ?? [])
					if (type(option) == 'string' && match(option, NAME))
						ctx.delete(config, section, option);
				continue;
			}
		}
		else if (op.op == 'order') {
			let position = 0;
			for (let name in op.sections ?? []) {
				let target = section_of(name);
				if (!exists(config, target))
					return failure('missing', sprintf('%s %s no longer exists', config, name));
				ctx.reorder(config, target, position++);
			}
			continue;
		}
		else
			return failure('invalid', sprintf('Unknown operation %s', op?.op));

		for (let key, value in values) {
			// A new WireGuard key is made here, so it never crosses the network.
			if (value == '@generate:wireguard-key') {
				value = wireguard_key();
				if (!value)
					return failure('invalid', 'WireGuard keys need the wireguard-tools package');
			}
			if (value == null || value == '' || type(value) == 'array' && !length(value))
				ctx.delete(config, section, key);
			else
				ctx.set(config, section, key, value);
		}
	}
	return { ok: true, touched, created, files };
}

function apply(request) {
	let args = request.args;
	if (type(args.ops) != 'array' || !length(args.ops) || length(args.ops) > 200)
		return failure('invalid', 'No changes were sent');
	if (luci_rollback_pending())
		return failure('busy', BUSY);
	ensure_dirs();
	let ctx = cursor(null, DELTA);
	let before = {};
	for (let name in CONFIGS)
		before[name] = config_text(name);

	let firewall_before = null;
	for (let op in args.ops)
		if (op?.config == 'firewall')
			firewall_before ??= fw_problems();

	let staged = stage(ctx, args.ops);
	if (!staged.ok) {
		for (let name in CONFIGS)
			ctx.revert(name);
		return staged;
	}
	let changed = [];
	for (let name, text in staged.files) {
		if (text != before[name]) {
			write_config(name, text);
			push(changed, name);
		}
	}
	for (let name in staged.touched) {
		if (!ctx.commit(name)) {
			for (let restore in [ ...staged.touched, ...changed ])
				write_config(restore, before[restore]);
			return failure('commit', sprintf('Could not save %s', name));
		}
		if (config_text(name) != before[name])
			push(changed, name);
	}
	if (!length(changed))
		return { ok: true, changed: [], created: staged.created };

	if ('firewall' in changed) {
		let check = fw_problems();
		let problems = check.code == 0 ? new_problems(firewall_before, check) : [ check.output ];
		if (length(problems)) {
			for (let name in changed)
				write_config(name, before[name]);
			return failure('rejected', 'The firewall rejected this change', { details: join('\n', problems) });
		}
	}
	if ('firewall' in changed)
		sync_firewall_sets(before.firewall, config_text('firewall'));
	if ('fstab' in changed)
		sync_mounts(before.fstab, config_text('fstab'));
	if ('sysctl' in changed)
		sync_sysctl(before.sysctl, config_text('sysctl'));
	announce(changed);
	if ('system' in changed)
		sync_leds(before.system, config_text('system'));
	if ('network' in changed)
		restart_wireguard(before.network, config_text('network'));

	let safe = safe_state();
	// A new change discards the redo branch, as in any undo history.
	let entries = filter(history_load(), entry => !entry.undone);
	let entry = {
		id: int(read_json(HISTORY_ID, 0)) + 1, time: time(), user: user_of(request),
		description: type(args.description) == 'string' ? substr(args.description, 0, 200) : 'Change configuration',
		configs: changed, before: {}, after: {}, safemode: safe != null
	};
	for (let name in changed) {
		entry.before[name] = before[name];
		entry.after[name] = config_text(name);
	}
	push(entries, entry);
	history_save(entries);
	write_json(HISTORY_ID, entry.id);

	let released = false;
	if (safe) {
		safe.count = (safe.count ?? 0) + 1;
		if (safe.count > SAFE_LIMIT) {
			// Like RouterOS: past the limit Safe Mode ends and keeps the changes.
			release_safe(false);
			released = true;
		}
		else
			write_json(SAFE + '/state.json', safe);
	}
	return { ok: true, id: entry.id, changed, created: staged.created, safemode_released: released };
}

function history_summary() {
	let entries = history_load();
	let undo = null, redo = null;
	for (let entry in entries) {
		if (!entry.undone)
			undo = entry;
		else if (!redo)
			redo = entry;
	}
	let summary = entry => entry ? { id: entry.id, description: entry.description, time: entry.time, user: entry.user } : null;
	return {
		undo: summary(undo), redo: summary(redo),
		entries: map(entries, entry => ({ ...summary(entry), configs: entry.configs, undone: !!entry.undone, safemode: !!entry.safemode }))
	};
}

function undo_redo(direction) {
	if (luci_rollback_pending())
		return failure('busy', BUSY);
	let entries = history_load();
	let target = null;
	for (let entry in entries) {
		if (direction == 'undo' && !entry.undone)
			target = entry;
		else if (direction == 'redo' && entry.undone && !target)
			target = entry;
	}
	if (!target)
		return failure('empty', direction == 'undo' ? 'Nothing to undo' : 'Nothing to redo');
	let expected = direction == 'undo' ? target.after : target.before;
	let wanted = direction == 'undo' ? target.before : target.after;
	// A daemon may have written its own options since (miniupnpd's UUID);
	// the change is then carried over onto the file as it is now.
	let texts = {};
	for (let name in target.configs) {
		let current = config_text(name);
		texts[name] = current == expected[name] ? wanted[name] : merge_config(name, expected[name], wanted[name], current);
		if (texts[name] == null)
			return failure('conflict', sprintf('%s was changed outside this history, so %s is not possible', name, direction));
	}
	for (let name in target.configs)
		write_config(name, texts[name]);
	if ('firewall' in target.configs)
		sync_firewall_sets(expected.firewall, wanted.firewall);
	if ('fstab' in target.configs)
		sync_mounts(expected.fstab, wanted.fstab);
	if ('sysctl' in target.configs)
		sync_sysctl(expected.sysctl, wanted.sysctl);
	announce(target.configs);
	if ('system' in target.configs)
		sync_leds(expected.system, wanted.system);
	if ('network' in target.configs)
		restart_wireguard(expected.network, wanted.network);
	target.undone = direction == 'undo';
	history_save(entries);
	return { ok: true, id: target.id, description: target.description, configs: target.configs };
}

/* --- Safe Mode ---------------------------------------------------------- */

function safemode(request) {
	let args = request.args, sid = args.ubus_rpc_session;
	let state = safe_state();
	let mine = state != null && state.sid == sid;
	let status = extra => {
		let current = safe_state();
		return {
			ok: true,
			active: current != null,
			mine: current != null && current.sid == sid,
			owner: current?.user,
			count: current?.count ?? 0,
			limit: SAFE_LIMIT,
			timeout: current?.timeout ?? SAFE_TIMEOUT,
			heartbeat_age: current ? time() - safe_heartbeat() : null,
			last_rollback: read_json(LAST_ROLLBACK, null),
			...(extra ?? {})
		};
	};
	if (args.action == 'status')
		return status();
	if (args.action == 'ping') {
		if (mine)
			write_heartbeat();
		return status();
	}
	if (args.action == 'enter') {
		if (state && !mine && time() - safe_heartbeat() <= state.timeout)
			return failure('taken', sprintf('Safe Mode is used by %s', state.user ?? 'another session'), { owner: state.user });
		if (state && !mine)
			release_safe(true);
		if (!mine) {
			ensure_dirs();
			for (let name in CONFIGS)
				write_text(SAFE + '/snapshot/' + name, config_text(name));
			let timeout = args.timeout >= 10 && args.timeout <= 600 ? args.timeout : SAFE_TIMEOUT;
			write_json(SAFE + '/state.json', { sid, user: user_of(request), since: time(), timeout, count: 0, configs: CONFIGS });
		}
		write_heartbeat();
		// Without its watchdog Safe Mode would protect nothing; never pretend.
		if (!watchdog('start')) {
			if (!mine)
				safe_clear();
			return failure('watchdog', 'The Safe Mode watchdog could not be started, so Safe Mode is off');
		}
		return status();
	}
	// Like RouterOS: another session may take Safe Mode over and keep its
	// changes protected, e.g. after a change moved the console to a new address.
	if (args.action == 'takeover') {
		if (!state)
			return failure('empty', 'Safe Mode is not active');
		if (!mine) {
			log_message(sprintf('Safe Mode taken over by %s from %s', user_of(request), state.user ?? 'another session'));
			state.previous_user = state.user;
			state.sid = sid;
			state.user = user_of(request);
			write_json(SAFE + '/state.json', state);
		}
		write_heartbeat();
		return status();
	}
	if (args.action == 'exit') {
		if (state && !mine)
			return failure('taken', sprintf('Safe Mode belongs to %s', state.user ?? 'another session'), { owner: state.user });
		return status({ restored: release_safe(args.keep === false) });
	}
	return failure('invalid', 'Unknown Safe Mode action');
}

