#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
// Runs one Ping or Traceroute job for the console. It runs outside rpcd,
// which handles one call at a time and would stall every window while a probe
// waits for its timeout. Results are appended to <job>/results as JSON lines;
// the job ends when it is stopped or done, or once no client has read its
// results for a while.
'use strict';

import { open, stat, access, popen } from 'fs';
import { read_json } from 'routerdeck.core';

const IDLE = 15;
const LIMIT = 3600;
const HOST = /^[A-Za-z0-9:][A-Za-z0-9.:-]{0,252}$/;

const dir = ARGV[0];
const job = read_json(dir + '/args.json', null);
// A host is needed except for a network scan and an iperf3 server.
const needs_host = job && !(job.tool == 'scan' || job.tool == 'bandwidth' && job.mode == 'server');
if (!job || needs_host && (type(job.host) != 'string' || !match(job.host, HOST)))
	exit(1);
const started = time();

function write(entry) {
	let file = open(dir + '/results', 'a');
	file.write(sprintf('%J\n', entry));
	file.close();
}

// The plugin touches `seen` on every read.
function alive() {
	// Stopped, or the package was removed with /var/run/routerdeck.
	if (access(dir + '/stop') || !access(dir))
		return false;
	let seen = stat(dir + '/seen')?.mtime ?? started;
	return time() - seen <= IDLE && time() - started <= LIMIT;
}

function run(command) {
	let pipe = popen(command + ' 2>&1', 'r');
	if (!pipe)
		return '';
	let output = pipe.read('all') ?? '';
	pipe.close();
	return output;
}

function now_ms() {
	let now = clock(true);
	return now[0] * 1000 + now[1] / 1000000;
}

// Wait for the rest of the interval, noticing Stop within a quarter second.
function pause(since) {
	let left = job.interval - (now_ms() - since);
	while (left > 0 && alive()) {
		sleep(int(min(left, 250)));
		left = job.interval - (now_ms() - since);
	}
}

const FAMILY = job.family == 6 ? '-6 ' : job.family == 4 ? '-4 ' : '';

// One echo request per process: busybox ping prints nothing for a lost
// reply, and this way every sequence number gets a definite result.
function ping() {
	let target = job.host;
	for (let seq = 0; (!job.count || seq < job.count) && alive(); seq++) {
		let since = now_ms();
		let output = run(sprintf('ping %s-c 1 -W %d -s %d %s', FAMILY, job.timeout, job.size, target));
		let header = match(output, /PING [^ ]+ \(([^)]+)\)/);
		if (!header) {
			write({ error: 'resolve', message: trim(output) || 'Host not found' });
			return;
		}
		// Resolve a name once; later requests go to the same address.
		if (seq == 0) {
			target = header[1];
			write({ address: target });
		}
		let reply = match(output, /([0-9]+) bytes from (.+): seq=[0-9]+ ttl=([0-9]+) time=([0-9.]+) ms/);
		let problem = match(output, /\nping: ([^\n]+)/);
		if (reply)
			write({ seq, host: reply[2], size: +reply[1], ttl: +reply[3], time: +reply[4] });
		else
			write({ seq, status: problem ? problem[1] : 'timeout' });
		pause(since);
	}
}

function parse_hop(output, hop) {
	for (let line in split(output, '\n')) {
		let found = match(line, /^ *([0-9]+) +([^ ]+)( +([0-9.]+) ms)?( +(![A-Za-z0-9]*))?/);
		if (found && +found[1] == hop)
			return { hop, address: found[2] == '*' ? null : found[2], time: found[4] != null ? +found[4] : null, status: found[6] };
	}
	return { hop, address: null, time: null };
}

// Like mtr: every round sends one probe to each hop, all at once, so a silent
// hop costs one timeout per round instead of one per hop.
function traceroute() {
	let target = job.host, last = job.max;
	let options = sprintf('%s%s-n -q 1 -w %d', FAMILY, job.protocol == 'udp' ? '' : '-I ', job.timeout);
	for (let round = 1; (!job.count || round <= job.count) && alive(); round++) {
		let since = now_ms(), script = '';
		for (let hop = 1; hop <= last; hop++)
			script += sprintf('traceroute %s -f %d -m %d %s >%s/hop.%d 2>&1 & ', options, hop, hop, target, dir, hop);
		system([ '/bin/sh', '-c', script + 'wait' ]);
		let hops = [];
		for (let hop = 1; hop <= last; hop++) {
			let output = open(dir + '/hop.' + hop, 'r')?.read('all') ?? '';
			if (round == 1 && hop == 1) {
				let header = match(output, /traceroute to [^ ]+ \(([^)]+)\)/);
				if (!header) {
					write({ error: 'resolve', message: trim(output) || 'Host not found' });
					return;
				}
				target = header[1];
				write({ address: target });
			}
			push(hops, parse_hop(output, hop));
		}
		// The path ends at the first hop that is the destination itself.
		for (let item in hops)
			if (item.address == target && item.hop < last)
				last = item.hop;
		write({ round, hops: filter(hops, item => item.hop <= last) });
		pause(since);
	}
}

const UNITS = { '': 1, K: 1e3, M: 1e6, G: 1e9, T: 1e12 };

// iperf3 prints one line per second with --forceflush; each becomes a
// result as it arrives. The tool's pid lets Stop end a waiting server.
function bandwidth() {
	let options = job.mode == 'server'
		? sprintf('-s -1 -p %d', job.port)
		: sprintf('%s-c %s -p %d -t %d %s%s', FAMILY, job.host, job.port, job.duration, { receive: '-R ', both: '--bidir ' }[job.direction] ?? '', job.protocol == 'udp' ? sprintf('-u -b %d ', job.bitrate || 10000000) : '');
	let pipe = popen(sprintf('echo $$ >%s/child.pid; exec iperf3 %s -i 1 --forceflush 2>&1', dir, options), 'r');
	if (!pipe) {
		write({ error: 'iperf', message: 'iperf3 could not be started' });
		return;
	}
	let line;
	while ((line = pipe.read('line')) != null && line != '') {
		let rate = match(line, /^\[ *[0-9A-Z]+\](\[([A-Z]+)-[CS]\])? +([0-9.]+)-([0-9.]+) +sec +([0-9.]+) ([KMGT]?)Bytes +([0-9.]+) ([KMGT]?)bits\/sec(.*)$/);
		if (rate) {
			let summary = match(rate[9], /(sender|receiver)/);
			write({ role: rate[2] ?? null, start: +rate[3], end: +rate[4], bytes: +rate[5] * UNITS[rate[6]], bps: +rate[7] * UNITS[rate[8]], summary: summary ? summary[1] : null, lost: match(rate[9], /([0-9]+)\/([0-9]+) \(/) ? +match(rate[9], /([0-9]+)\/([0-9]+) \(/)[1] : null });
		}
		else if (match(line, /^iperf3: (error|interrupt)/))
			write({ error: 'iperf', message: trim(replace(line, /^iperf3: /, '')) });
		else if (match(line, /^(Connecting to|Server listening|Accepted connection)/))
			write({ status: trim(line) });
		if (!alive())
			break;
	}
	pipe.close();
}

function ipv4(text) {
	let parts = split(text, '.');
	return ((+parts[0] * 256 + +parts[1]) * 256 + +parts[2]) * 256 + +parts[3];
}
const dotted = value => sprintf('%d.%d.%d.%d', (value >> 24) & 255, (value >> 16) & 255, (value >> 8) & 255, value & 255);

// Pings every host address of the network, 32 at a time, then adds the
// MAC addresses the neighbour table learned on the way.
function scan() {
	let parts = split(job.network, '/'), prefix = +parts[1];
	let size = 1 << (32 - prefix), base = ipv4(parts[0]) - ipv4(parts[0]) % size;
	let hosts = [];
	for (let i = 1; i < size - 1; i++)
		push(hosts, dotted(base + i));
	write({ total: length(hosts) });
	for (let first = 0; first < length(hosts) && alive(); first += 32) {
		let batch = slice(hosts, first, first + 32), script = '';
		for (let i = 0; i < length(batch); i++)
			script += sprintf('ping -c 1 -W 1 %s >%s/scan.%d 2>&1 & ', batch[i], dir, i);
		system([ '/bin/sh', '-c', script + 'wait' ]);
		for (let i = 0; i < length(batch); i++) {
			let reply = match(open(dir + '/scan.' + i, 'r')?.read('all') ?? '', /ttl=([0-9]+) time=([0-9.]+) ms/);
			if (reply)
				write({ address: batch[i], time: +reply[2], ttl: +reply[1] });
		}
		write({ scanned: min(first + 32, length(hosts)) });
	}
	let macs = {};
	for (let line in split(run('ip -4 neigh'), '\n')) {
		let words = split(trim(line), /\s+/);
		let mac = index(words, 'lladdr');
		if (mac > 0 && words[mac + 1])
			macs[words[0]] = words[mac + 1];
	}
	write({ macs });
}

if (job.tool == 'ping')
	ping();
else if (job.tool == 'traceroute')
	traceroute();
else if (job.tool == 'bandwidth')
	bandwidth();
else if (job.tool == 'scan')
	scan();
