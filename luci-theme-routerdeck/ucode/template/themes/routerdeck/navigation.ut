{# RouterDeck navigation is delivered with the page, not a fallible module request. #}
<script>
(function () {
 'use strict';
 const container = document.getElementById('rd-navigation');
 if (!container || window.routerdeckNavigationStarted) return;
 window.routerdeckNavigationStarted = true;
 const translate = text => typeof window._ === 'function' ? _(text) : text;
 const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
 function deadline(promise, ms) {
  return new Promise((resolve, reject) => {
   const timer = setTimeout(() => reject(new Error('Navigation request timed out')), ms);
   Promise.resolve(promise).then(value => { clearTimeout(timer); resolve(value); }, error => { clearTimeout(timer); reject(error); });
  });
 }
 function message(text, retry) {
  const note = document.createElement('p'); note.className = 'rd-muted'; note.textContent = translate(text); note.setAttribute('role', 'status');
  const nodes = [note];
  if (retry) {
   const button = document.createElement('button'); button.type = 'button'; button.className = 'btn';
   button.textContent = translate('Retry'); button.addEventListener('click', retry); nodes.push(button);
  }
  container.replaceChildren(...nodes); container.setAttribute('aria-busy', String(!retry));
 }
 async function loadAsset(name, ready) {
  if (ready()) return;
  const original = Array.from(document.scripts).find(script => new URL(script.src || location.href).pathname.endsWith('/routerdeck/' + name));
  if (!original) throw new Error('Missing theme asset');
  for (let attempt = 0; attempt < 3; attempt++) {
   if (ready()) return;
   try {
    await new Promise((resolve, reject) => {
     const script = document.createElement('script');
     const timer = setTimeout(() => { script.remove(); reject(new Error('Theme asset timed out')); }, 5000);
     script.src = original.src;
     script.onload = () => { clearTimeout(timer); ready() ? resolve() : reject(new Error('Theme asset did not initialize')); };
     script.onerror = () => { clearTimeout(timer); script.remove(); reject(new Error('Theme asset unavailable')); };
     document.head.append(script);
    });
    return;
   } catch (error) { if (attempt === 2) throw error; await delay(300 * (attempt + 1)); }
  }
 }
 // Shared with the dashboard's optional renderer: recover core once, without
 // reexecuting it in two parallel loaders and resetting an initialized theme.
 window.routerdeckReady = loadAsset('core.js', () => typeof window.RouterDeck?.init === 'function');
 let ui, busy = false;
 const controller = {
  load: async function () {
   if (busy) return;
   busy = true; message('Loading navigation…');
   try {
    for (let attempt = 0; attempt < 3; attempt++) {
     try {
      const tree = await deadline(ui.menu.load(), 5000);
      this.render(tree);
      container.setAttribute('aria-busy', 'false');
      const search = document.getElementById('rd-menu-search');
      if (search?.value) search.dispatchEvent(new Event('input', { bubbles: true }));
      return;
     } catch (error) {
      // LuCI caches the rejected menu Promise. Clear that failed request only;
      // getChildren still owns dependency/ACL checks on every successful tree.
      ui.menu.menu = null;
      if (attempt === 2) throw error;
      message('Reconnecting to navigation…'); await delay(300 * (attempt + 1));
     }
    }
   } catch (_) {
    message('Navigation could not be loaded.', () => this.load());
   } finally { busy = false; }
  },
 render: function (tree) {
  const mode = L.env.dispatchpath[0] || 'admin';
  const current = L.env.dispatchpath.slice(0, 3).join('/');
  const groups = ui.menu.getChildren(tree.children?.[mode] || tree).map(group => {
   const children = ui.menu.getChildren(group).filter(child => child.action?.path !== 'routerdeck/workspace' && child.name !== 'workspace');
   return { title: _(group.title), items: (children.length ? children : [group]).map(child => {
    const path = children.length ? [mode, group.name, child.name] : [mode, child.name];
    return { id: path.join('/'), href: L.url(...path), title: _(child.title) };
   }) };
  });
  // Preserve alternate LuCI modes supplied by installed applications.
  const modes = ui.menu.getChildren(tree).filter(child => child.name !== mode);
  if (modes.length) groups.push({ title: _('Other modes'), items: modes.map(child => ({ id: child.name, href: L.url(child.name), title: _(child.title) })) });
  RouterDeck.navigation(groups, current);
  let node = tree;
  L.env.dispatchpath.slice(0, 3).forEach(segment => { node = node?.children?.[segment]; });
  document.getElementById('tabmenu')?.replaceChildren();
  if (node) this.tabs(node, L.env.dispatchpath.slice(0, 3), 3);
  this.enhance(tree).catch(error => console.warn('RouterDeck page enhancements unavailable', error));
 },
 enhance: async function (tree) {
  const pages = [];
  const visit = (node, path, ancestors = new Set()) => {
   if (ancestors.has(node)) return false;
   const seen = new Set(ancestors).add(node);
   let hasView = false;
   for (const child of ui.menu.getChildren(node)) {
    if (child.action?.path === 'routerdeck/workspace' || child.name === 'workspace') continue;
    const route = path.concat(child.name);
    const descendants = visit(node.children?.[child.name] || child, route, seen);
    // Overview is the stock read-only legacy template, not a JS view. Keep
    // other template/call/action endpoints out of the window allowlist.
    const overview = route.join('/') === 'admin/status/overview' && child.action?.type === 'template' && child.action.path === 'admin_status/index';
    if (child.action?.type === 'view' || child.action?.type === 'firstchild' && descendants || overview) {
     const title = route.join('/') === 'admin/network/firewall/zones' ? _('Firewall zones') : _(child.title);
     pages.push({ title, href: L.url(...route) }); hasView = true;
    }
    hasView = hasView || descendants;
   }
   return hasView;
  };
  visit(tree, []);
  if (typeof RouterDeck.initWindows !== 'function') {
   try { await loadAsset('windows.js', () => typeof window.RouterDeck?.initWindows === 'function'); } catch (_) {}
  }
  RouterDeck.initWindows?.(pages);
  L.require('routerdeck-links').then(links => links.init(tree)).catch(error => console.warn('RouterDeck contextual navigation unavailable', error));
 },
 tabs: function (node, path, depth) {
  const children = ui.menu.getChildren(node);
  if (!children.length) return;
  const container = document.getElementById('tabmenu');
  container.style.display = '';
  container.appendChild(E('ul', { class: 'tabs' }, children.map(child => E('li', { class: L.env.dispatchpath[depth] === child.name ? 'active' : '' }, E('a', { href: L.url(...path, child.name) }, _(child.title))))));
  const active = children.find(child => child.name === L.env.dispatchpath[depth]);
  if (active) this.tabs(active, path.concat(active.name), depth + 1);
 }

 };
 async function headerStatus() {
  if (!L.loaded) await deadline(new Promise(resolve => document.addEventListener('luci-loaded', resolve, { once: true })), 15000);
  const [rpc, poll] = await Promise.all([L.require('rpc'), L.require('poll')]);
  const info = rpc.declare({ object: 'system', method: 'info', expect: { '': {} } });
  const interfaces = rpc.declare({ object: 'network.interface', method: 'dump', expect: { interface: [] } });
  const update = () => {
   if (document.hidden) return Promise.resolve();
   return Promise.all([L.resolveDefault(info(), {}), L.resolveDefault(interfaces(), [])]).then(([system, nets]) => {
    const memory = system.memory, wan = nets.find(net => (net.route || []).some(route => route.target === '0.0.0.0' && route.mask === 0));
    const values = [
     ['Uptime', RouterDeck.uptime(system.uptime)],
     ['Load', Array.isArray(system.load) ? (system.load[0] / 65536).toFixed(2) : '—'],
     ['RAM', memory?.total ? Math.round(100 * (memory.total - (memory.available ?? memory.free)) / memory.total) + '%' : '—'],
     ['WAN', wan ? (wan.up ? 'Up' : 'Down') : '—']
    ];
    document.getElementById('rd-header-stats')?.replaceChildren(...values.map(([label, value]) => E('span', {}, [E('small', {}, label), E('strong', {}, value)])));
   });
  };
  update().catch(() => {}); poll.add(update, 10);
 }
 (async () => {
  await window.routerdeckReady;
  if (!window.L) throw new Error('LuCI runtime unavailable');
  ui = await deadline(L.require('ui'), 10000);
  RouterDeck.init();
  if (L.env.dispatchpath.join('/') === 'admin/system/admin/password') {
   const content = document.getElementById('maincontent');
   const markNewPasswords = () => content.querySelectorAll('input[type="password"]').forEach(input => input.setAttribute('autocomplete', 'new-password'));
   markNewPasswords(); new MutationObserver(markNewPasswords).observe(content, { childList: true, subtree: true });
  }
  controller.load();
  headerStatus().catch(() => {});
 })().catch(() => message('Page resources could not be loaded.', () => location.reload()));
})();
</script>
