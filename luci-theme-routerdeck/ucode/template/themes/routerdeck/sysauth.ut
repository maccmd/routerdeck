{# Apache-2.0. Standard LuCI login POST; authentication remains in the dispatcher. #}
{% include('header', { blank_page: true }) %}
<main class="rd-login-card">
 <img src="{{ media }}/mark.svg" width="40" height="40" alt="">
 <h1>RouterDeck</h1>
 <p class="rd-muted">{{ _('Authorization Required') }}</p>
 {% if (fuser): %}
 <div class="alert-message error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
 {% endif %}
 <form method="post">
  <label class="rd-field" for="luci_username">{{ _('Username') }}<input name="luci_username" id="luci_username" autocomplete="username" value="{{ entityencode(duser, true) }}" required></label>
  <label class="rd-field" for="luci_password">{{ _('Password') }}<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus></label>
  <button type="submit" class="btn cbi-button-positive">{{ _('Log in') }}</button>
 </form>
</main>
{% include('footer', { blank_page: true }) %}
